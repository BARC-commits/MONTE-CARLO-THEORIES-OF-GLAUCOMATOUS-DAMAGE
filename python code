# 10. FACE VALIDITY: COMPARISON TO EPIDEMIOLOGICAL BENCHMARKS
# =============================================================================
print("\n" + "=" * 70)
print("FACE VALIDITY: COMPARISON TO EPIDEMIOLOGICAL BENCHMARKS")
print("=" * 70)
print("Published pooled global prevalence in adults 40-80 is ~3.5%.")
print("The uncalibrated simulated prevalence is far higher, indicating that")
print("the constants are not calibrated to population epidemiology.")

print("\nOne-parameter grid search toward a 3.5% prevalence target (equal weights):")
print("(This is an illustrative calibration hook, not full ABC.)")
target_prev = 0.035
w_cal = {'mechanical': 1/3, 'vascular': 1/3, 'glymphatic': 1/3}

cal_n = 100_000
cal_idx = np.random.choice(n_eyes, size=cal_n, replace=False)
meas_cal = measured_iop[cal_idx]
age_c = age[cal_idx]; ss_c = scleral_stiffness[cal_idx]
lc_c = lc_pore_diam[cal_idx]; csfp_c = csfp[cal_idx]
mv_c = mech_vulnerability[cal_idx]; ch_c = corneal_hysteresis[cal_idx]
opp_c = opp[cal_idx]; vv_c = vascular_vulnerability[cal_idx]
gv_c = glymphatic_vulnerability[cal_idx]

def calibrated_prevalence(base_const):
    m = (base_const + (-0.10)*(age_c-60) + 2.0*(ss_c-1.5)
         - 6.0*(lc_c-40)/40 + 0.3*(csfp_c-12) - 12.0*mv_c
         - 0.15*(ch_c-10.5))
    v = (base_const + (-8.0)*np.clip(1-opp_c/50, 0, 1)
         + (-4.0)*np.where(age_c>65, 0.3, 0.1) - 10.0*vv_c)
    g = (base_const + (-0.10)*(age_c-60) + 0.5*(csfp_c-12) - 12.0*gv_c)
    thr = np.clip(w_cal['mechanical']*m + w_cal['vascular']*v
                  + w_cal['glymphatic']*g, THRESHOLD_FLOOR, THRESHOLD_CEILING)
    return (meas_cal > thr).mean()

best_const, best_gap, best_prev = 24.0, np.inf, None
for base_const in np.arange(18.0, 40.0, 0.5):
    prev = calibrated_prevalence(base_const)
    gap = abs(prev - target_prev)
    if gap < best_gap:
        best_gap, best_const, best_prev = gap, base_const, prev
print(f"  Best baseline constant: {best_const:.1f} mmHg")
print(f"  Calibrated prevalence: {best_prev*100:.2f}% (target {target_prev*100:.1f}%)")
print("  NOTE: calibration is illustrative; external validation is still required.")
print(f"  NOTE: calibration raises the baseline constant to ~{best_const:.1f} mmHg,")
print("  which inverts the uncalibrated '<21 mmHg' narrative. This tension is")
print("  itself a key face-validity finding and should be discussed in the manuscript.")

