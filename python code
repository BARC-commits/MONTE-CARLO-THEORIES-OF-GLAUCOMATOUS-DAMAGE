# =============================================================================
# MONTE CARLO SIMULATION: INTEGRATED MECHANICAL, VASCULAR, AND GLYMPHATIC
# THEORIES OF GLAUCOMATOUS DAMAGE
#
# This simulation explores how different weightings of three mechanisms
# affect predicted IOP thresholds and glaucoma classification.
# The weights are arbitrary; the value lies in showing sensitivity.
#
# IMPORTANT: All findings are internal to the model. The model generates
# its own disease labels. Without external validation against clinical
# outcomes, these findings should not be interpreted as evidence for or
# against clinical practice.
# =============================================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import warnings
warnings.filterwarnings('ignore')

from scipy.stats import spearmanr

# Set publication quality style
try:
    plt.style.use('seaborn-v0_8-whitegrid')
except:
    try:
        plt.style.use('seaborn-whitegrid')
    except:
        pass

plt.rcParams['font.family'] = 'sans-serif'
plt.rcParams['font.sans-serif'] = ['DejaVu Sans', 'Liberation Sans', 'Bitstream Vera Sans']
plt.rcParams['font.size'] = 11
plt.rcParams['axes.titlesize'] = 13
plt.rcParams['axes.labelsize'] = 11
plt.rcParams['legend.fontsize'] = 9
plt.rcParams['figure.dpi'] = 100
plt.rcParams['savefig.dpi'] = 300
plt.rcParams['savefig.bbox'] = 'tight'
plt.rcParams['figure.figsize'] = (10, 8)

np.random.seed(2026)

# Physiological floor and ceiling for component thresholds
THRESHOLD_FLOOR = 5.0
THRESHOLD_CEILING = 40.0

# =============================================================================
# 1. POPULATION PARAMETERS
# =============================================================================
n_eyes = 100_000
print(f"Generating {n_eyes:,} virtual eyes...")

age = np.random.normal(loc=62, scale=14, size=n_eyes)
age = np.clip(age, 18, 95)

cct = np.random.normal(loc=550, scale=35, size=n_eyes)
cct = np.clip(cct, 450, 650)

corneal_hysteresis = np.random.normal(loc=10.5, scale=1.8, size=n_eyes)
corneal_hysteresis = np.clip(corneal_hysteresis, 6, 16)

scleral_stiffness = (
    1.5
    + 0.006 * (age - 62)
    + 0.004 * (550 - cct)
    + np.random.normal(0, 0.12, n_eyes)
)
scleral_stiffness = np.clip(scleral_stiffness, 0.8, 2.5)

lc_pore_diam = np.random.normal(loc=40, scale=10, size=n_eyes)
lc_pore_diam = np.clip(lc_pore_diam, 15, 80)

baseline_iop = np.random.normal(loc=16.5, scale=3.5, size=n_eyes)
baseline_iop = np.clip(baseline_iop, 8, 35)

map_pressure = np.random.normal(loc=95, scale=12, size=n_eyes)
map_pressure = np.clip(map_pressure, 65, 130)

csfp = np.random.normal(loc=12, scale=3, size=n_eyes)
csfp = np.clip(csfp, 5, 20)

# =============================================================================
# 2. MECHANICAL VULNERABILITY
# =============================================================================
print("Calculating mechanical vulnerability...")

mech_vulnerability = np.random.beta(a=1.5, b=4, size=n_eyes)

thin_lc = np.random.binomial(1, 0.08, size=n_eyes)
mech_vulnerability += 0.4 * thin_lc

family_history = np.random.binomial(1, 0.10, size=n_eyes)
mech_vulnerability += 0.25 * family_history

mech_vulnerability = np.clip(mech_vulnerability, 0, 1)

ch_effect = -0.15 * (corneal_hysteresis - 10.5)

mech_threshold = (
    24.0
    - 0.10 * (age - 60)
    + 2.0 * (scleral_stiffness - 1.5)
    - 6.0 * (lc_pore_diam - 40) / 40
    + 0.3 * (csfp - 12)
    - 12.0 * mech_vulnerability
    + ch_effect
    + np.random.normal(0, 1.5, n_eyes)
)
mech_threshold = np.clip(mech_threshold, THRESHOLD_FLOOR, THRESHOLD_CEILING)

# =============================================================================
# 3. VASCULAR VULNERABILITY
# =============================================================================
print("Calculating vascular vulnerability...")

vascular_vulnerability = np.random.beta(a=2, b=5, size=n_eyes)

nocturnal_dip_fraction = np.random.normal(loc=0.10, scale=0.07, size=n_eyes)
nocturnal_dip_fraction = np.clip(nocturnal_dip_fraction, 0.0, 0.40)
nocturnal_dip_mmhg = nocturnal_dip_fraction * map_pressure
nocturnal_hypotension = (nocturnal_dip_mmhg > 20).astype(int)
vascular_vulnerability += 0.2 * nocturnal_hypotension

sleep_apnea = np.random.binomial(1, 0.03, size=n_eyes)
vascular_vulnerability += 0.5 * sleep_apnea

diabetes = np.random.binomial(1, 0.08, size=n_eyes)
vascular_vulnerability += 0.3 * diabetes

hypertension = np.random.binomial(1, 0.15, size=n_eyes)
vascular_vulnerability += 0.2 * hypertension

vascular_vulnerability = np.clip(vascular_vulnerability, 0, 1)

iop_measurement_noise = np.random.normal(0, 2.0, size=n_eyes)
measured_iop = np.clip(baseline_iop + iop_measurement_noise, 5, 40)

# Conventional estimate of mean ocular perfusion pressure
opp = (2.0 / 3.0) * map_pressure - measured_iop

perfusion_effect = -8.0 * np.clip(1.0 - opp / 50.0, 0.0, 1.0)

autoreg_coeff = np.where(age > 65, 0.3, 0.1)
autoreg_effect = -4.0 * autoreg_coeff

vascular_threshold = (
    24.0
    + perfusion_effect
    + autoreg_effect
    - 10.0 * vascular_vulnerability
    + np.random.normal(0, 1.5, n_eyes)
)
vascular_threshold = np.clip(vascular_threshold, THRESHOLD_FLOOR, THRESHOLD_CEILING)

# =============================================================================
# 4. GLYMPHATIC VULNERABILITY
# =============================================================================
print("Calculating glymphatic vulnerability...")

glymphatic_vulnerability = np.random.beta(a=1.5, b=3, size=n_eyes)

glymphatic_variant = np.random.binomial(1, 0.15, size=n_eyes)
glymphatic_vulnerability += 0.3 * glymphatic_variant

sleep_disturbance = 0.5 * sleep_apnea + 0.01 * np.clip(age - 60, 0, None)
glymphatic_vulnerability += 0.3 * sleep_disturbance

glymphatic_vulnerability += 0.05 * np.clip(12 - csfp, 0, None)

glymphatic_vulnerability = np.clip(glymphatic_vulnerability, 0, 1)

glymphatic_threshold = (
    24.0
    - 0.10 * (age - 60)
    + 0.5 * (csfp - 12)
    - 12.0 * glymphatic_vulnerability
    + np.random.normal(0, 1.5, n_eyes)
)
glymphatic_threshold = np.clip(glymphatic_threshold, THRESHOLD_FLOOR, THRESHOLD_CEILING)

# =============================================================================
# 5. INTEGRATED THRESHOLDS AND WEIGHT CONFIGURATIONS
# =============================================================================
print("Calculating thresholds...")

weight_configs = [
    {'mechanical': 0.50, 'vascular': 0.30, 'glymphatic': 0.20},
    {'mechanical': 0.30, 'vascular': 0.50, 'glymphatic': 0.20},
    {'mechanical': 0.30, 'vascular': 0.20, 'glymphatic': 0.50},
    {'mechanical': 0.40, 'vascular': 0.30, 'glymphatic': 0.30},
    {'mechanical': 0.33, 'vascular': 0.33, 'glymphatic': 0.34},
]

def integrated_threshold_additive(w, mech, vasc, glym):
    return w['mechanical'] * mech + w['vascular'] * vasc + w['glymphatic'] * glym

def integrated_threshold_weakest_link(mech, vasc, glym):
    return np.minimum(np.minimum(mech, vasc), glym)

# =============================================================================
# 6. CORRELATIONS AMONG COMPONENT THRESHOLDS
# =============================================================================
print("\nCorrelations among component thresholds (Spearman, marginal):")
corr_mv, _ = spearmanr(mech_threshold, vascular_threshold)
corr_mg, _ = spearmanr(mech_threshold, glymphatic_threshold)
corr_vg, _ = spearmanr(vascular_threshold, glymphatic_threshold)
print(f"  Mechanical vs Vascular: rho = {corr_mv:.3f}")
print(f"  Mechanical vs Glymphatic: rho = {corr_mg:.3f}")
print(f"  Vascular vs Glymphatic: rho = {corr_vg:.3f}")

# =============================================================================
# 6b. PARTIAL CORRELATIONS (residual shared-input dependence)
# =============================================================================
# Partial correlation of X and Y controlling for a set of covariates Z is
# computed from the Pearson correlation matrix R of [X, Y, Z...]:
#     r_XY|Z = -P_XY / sqrt(P_XX * P_YY)
# where P is the inverse of R and indices refer to X, Y in [0, 1].
# We compute it on the Pearson scale (the standard definition); the Spearman
# table above remains the rank-based companion statistic.
def partial_corr(x, y, controls):
    """Partial correlation of x and y controlling for the columns in controls."""
    controls = np.asarray(controls)
    if controls.ndim == 1:
        controls = controls.reshape(1, -1)
    data = np.vstack([x, y, controls]).astype(float)
    R = np.corrcoef(data)
    try:
        P = np.linalg.inv(R)
    except np.linalg.LinAlgError:
        return np.nan
    return -P[0, 1] / np.sqrt(P[0, 0] * P[1, 1])

print("\nPartial correlations (residual shared-input dependence):")
pc_mech_glym = partial_corr(mech_threshold, glymphatic_threshold,
                            [age, csfp])
pc_vasc_glym = partial_corr(vascular_threshold, glymphatic_threshold,
                            [sleep_apnea])
pc_mech_vasc = partial_corr(mech_threshold, vascular_threshold, [age])

print(f"  Mech vs Glymph | age, CSFP :  r = {pc_mech_glym:+.3f}")
print(f"  Vasc vs Glymph | sleep apnea:  r = {pc_vasc_glym:+.3f}")
print(f"  Mech vs Vasc   | age        :  r = {pc_mech_vasc:+.3f}")
print("  (Marginal Spearman rho above; partial r below. A large drop from")
print("   marginal to partial indicates that the shared inputs account for")
print("   most of the observed dependence among component thresholds.)")

# =============================================================================
# 7. CLASSIFICATION AND SENSITIVITY ANALYSIS
# =============================================================================
print("\n" + "=" * 70)
print("INTEGRATED GLAUCOMA MODEL: 100,000 VIRTUAL EYES")
print("=" * 70)
print(f"NOTE: Component thresholds are clipped to "
      f"[{THRESHOLD_FLOOR:.0f}, {THRESHOLD_CEILING:.0f}] mmHg as a modelling")
print("choice. A component threshold at exactly 5.00 mmHg is a floor artefact,")
print("not a physiological observation.")

def summarize(name, arr):
    print(f"{name}: {arr.mean():.2f} +/- {arr.std():.2f}  "
          f"[observed range {arr.min():.2f} - {arr.max():.2f}]")

print("\nPopulation Parameters (Mean +/- SD, observed range):")
summarize("Age (years)", age)
summarize("CCT (um)", cct)
summarize("Corneal Hysteresis (mmHg)", corneal_hysteresis)
summarize("Scleral Stiffness (a.u.)", scleral_stiffness)
summarize("LC Pore Diameter (um)", lc_pore_diam)
summarize("Baseline IOP (mmHg)", baseline_iop)
summarize("Measured IOP (mmHg)", measured_iop)
summarize("MAP (mmHg)", map_pressure)
summarize("CSFP (mmHg)", csfp)
summarize("OPP (mmHg)", opp)

print("\nVulnerability Scores (Mean +/- SD, observed range):")
summarize("Mechanical", mech_vulnerability)
summarize("Vascular", vascular_vulnerability)
summarize("Glymphatic", glymphatic_vulnerability)

print("\nConditions Prevalence:")
print(f"  Sleep Apnea: {sleep_apnea.mean()*100:.1f}%")
print(f"  Diabetes: {diabetes.mean()*100:.1f}%")
print(f"  Hypertension: {hypertension.mean()*100:.1f}%")
print(f"  Family History: {family_history.mean()*100:.1f}%")
print(f"  Nocturnal Hypotension (dip > 20 mmHg): {nocturnal_hypotension.mean()*100:.1f}%")

print("\nIndividual Theory Thresholds (Mean +/- SD, observed range):")
summarize("Mechanical", mech_threshold)
summarize("Vascular", vascular_threshold)
summarize("Glymphatic", glymphatic_threshold)

# =============================================================================
# 8. SENSITIVITY ANALYSIS: ADDITIVE vs WEAKEST-LINK, FIVE CONFIGURATIONS
# =============================================================================
print("\n" + "=" * 70)
print("SENSITIVITY ANALYSIS: EFFECT OF ARBITRARY WEIGHTS")
print("=" * 70)
print("All weight configurations are arbitrary. No single configuration is privileged.")
print("Results are reported for BOTH the additive rule and the weakest-link rule.")
print("NOTE: The weakest-link rule is weight-invariant by construction; its")
print("results are identical across all five configurations and are reported")
print("once as a separate finding, not as a weight-sensitivity result.")

results = []

for i, w in enumerate(weight_configs):
    thr_add = integrated_threshold_additive(
        w, mech_threshold, vascular_threshold, glymphatic_threshold)
    thr_add = np.clip(thr_add, THRESHOLD_FLOOR, THRESHOLD_CEILING)
    class_add = (measured_iop > thr_add).astype(int)
    glaucoma_add = class_add.mean() * 100
    ntg_add = ((measured_iop <= 21) & (class_add == 1)).mean() * 100

    results.append({
        'config': i + 1,
        'mech_w': w['mechanical'],
        'vasc_w': w['vascular'],
        'glymph_w': w['glymphatic'],
        'mean_threshold_additive': thr_add.mean(),
        'glaucoma_pct_additive': glaucoma_add,
        'ntg_pct_additive': ntg_add,
    })

    print(f"\nConfig {i+1} (Mech={w['mechanical']:.2f}, Vasc={w['vascular']:.2f}, "
          f"Glymph={w['glymphatic']:.2f})")
    print(f"  Additive: mean threshold = {thr_add.mean():.2f} mmHg, "
          f"glaucoma = {glaucoma_add:.2f}%, NTG = {ntg_add:.2f}%")

thr_weak = integrated_threshold_weakest_link(
    mech_threshold, vascular_threshold, glymphatic_threshold)
thr_weak = np.clip(thr_weak, THRESHOLD_FLOOR, THRESHOLD_CEILING)
class_weak = (measured_iop > thr_weak).astype(int)
glaucoma_weak = class_weak.mean() * 100
ntg_weak = ((measured_iop <= 21) & (class_weak == 1)).mean() * 100

print(f"\nWeakest-link rule (weight-invariant by construction):")
print(f"  Mean threshold = {thr_weak.mean():.2f} mmHg, "
      f"glaucoma = {glaucoma_weak:.2f}%, NTG = {ntg_weak:.2f}%")

add_means = [r['mean_threshold_additive'] for r in results]
add_glau = [r['glaucoma_pct_additive'] for r in results]
add_ntg = [r['ntg_pct_additive'] for r in results]

print("\n" + "=" * 70)
print("RANGE ACROSS ADDITIVE CONFIGURATIONS")
print("=" * 70)
print(f"  Mean threshold: {min(add_means):.2f} - {max(add_means):.2f} mmHg "
      f"(spread = {max(add_means)-min(add_means):.2f} mmHg)")
print(f"  Glaucoma prevalence: {min(add_glau):.2f}% - {max(add_glau):.2f}%")
print(f"  NTG prevalence: {min(add_ntg):.2f}% - {max(add_ntg):.2f}%")
print(f"\nWeakest-link rule (single value, weight-invariant):")
print(f"  Mean threshold = {thr_weak.mean():.2f} mmHg, "
      f"glaucoma = {glaucoma_weak:.2f}%, NTG = {ntg_weak:.2f}%")

# =============================================================================
# 9. VARIANCE-BASED GLOBAL SENSITIVITY ANALYSIS (WEIGHTS)
# =============================================================================
print("\n" + "=" * 70)
print("GLOBAL SENSITIVITY ANALYSIS (WEIGHTS)")
print("=" * 70)

# For Y = w . x with w ~ Dirichlet(alpha) on the 3-simplex, the first-order
# Sobol index is S1_i = (x_i - x_bar) * Cov(w_i, Y) / Var(Y); for a linear
# model ST_i = S1_i. Exact, no Monte Carlo error.
def sobol_dirichlet_analytic(x, alpha=(1.0, 1.0, 1.0)):
    x = np.asarray(x, dtype=float)
    a = np.asarray(alpha, dtype=float)
    a0 = a.sum()
    Sigma = np.zeros((3, 3))
    for i in range(3):
        for j in range(3):
            if i == j:
                Sigma[i, j] = a[i] * (a0 - a[i]) / (a0**2 * (a0 + 1.0))
            else:
                Sigma[i, j] = -a[i] * a[j] / (a0**2 * (a0 + 1.0))
    var_Y = x @ Sigma @ x
    x_bar = x.mean()
    S1 = np.zeros(3)
    for i in range(3):
        cov_wi_Y = Sigma[i, :] @ x
        S1[i] = (x[i] - x_bar) * cov_wi_Y / var_Y
    return S1, S1.copy(), var_Y

x_components = np.array([mech_threshold.mean(),
                         vascular_threshold.mean(),
                         glymphatic_threshold.mean()])
S1_w, ST_w, var_w = sobol_dirichlet_analytic(x_components, alpha=(1.0, 1.0, 1.0))

print("Sobol indices w.r.t. weights (analytic, Dirichlet(1,1,1) on simplex):")
labels = ['Mechanical', 'Vascular', 'Glymphatic']
for lab, s1, st in zip(labels, S1_w, ST_w):
    print(f"  {lab:12s}: S1 = {s1:+.4f}   ST = {st:+.4f}")
print(f"  Sum S1 = {S1_w.sum():.4f}  (should be 1.0)")
print(f"  Var(Y) = {var_w:.4f}")
print("  (Exact for the linear model; no MC error. ST = S1 for linear models.)")
print("\n  A full coefficient-level Sobol decomposition is not reported here.")
print("  The model's clipping nonlinearity and the shared-input structure make")
print("  the reduced-form estimator sensitive to the arbitrary coefficient")
print("  uncertainty band. Partial correlations (reported above) quantify the")
print("  residual shared-input dependence exactly and are the interpretable")
print("  analogue of the Sobol interaction share.")

